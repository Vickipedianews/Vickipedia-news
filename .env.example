# Local development: omit these entirely for SQLite and local uploads
PORT=3000
HOST=127.0.0.1
SITE_URL=http://localhost:3000
MEDIA_STORAGE=local

# On Vercel (use project environment variables; do not commit secrets)
# DATABASE_URL=postgresql://...                 # Neon pooled connection
# DATABASE_URL_UNPOOLED=postgresql://...        # Migration tooling
# MEDIA_STORAGE=vercel-blob
# BLOB_READ_WRITE_TOKEN=...

# Alternative: R2 or S3
# MEDIA_STORAGE=s3
# R2_ACCOUNT_ID=...
# R2_BUCKET=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# S3_PUBLIC_BASE_URL=https://media.example.com
# S3_REGION=auto

# Required to protect first administrator creation on Vercel/production
CMS_SETUP_TOKEN=generate_a_random_secret_of_at_least_24_characters
